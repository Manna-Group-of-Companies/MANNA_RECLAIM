# dependencies
node_modules/

# env - holds SUPABASE_SERVICE_KEY, never commit
# .env.example is committed on purpose
.env
.env.local
.env.development.local
.env.production.local
.env.test.local
# a copy of .env is still a copy of the secrets
.env.bak
.env.*.bak

# logs
logs/
*.log
npm-debug.log*
pids/
*.pid
*.seed

# tests
coverage/
.nyc_output/

# runtime artifacts
uploads/
tmp/
temp/
# what scripts/lot-key-split.js writes before it touches anything - real plant
# rows, and not ours to commit
backups/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# The SAP feed report - regenerated from the live database by
# `npm run sap:report`, so it is an output rather than a source. Committed it
# would be a snapshot of one afternoon's yard going stale in the repository,
# and read months later as though it were current.
sap-report.html

# The gate reader's own data - 437 people's names and movements. Read onto
# disk by scripts/punch-read.py to be imported; never committed.
scripts/punches.json

# Word lock files - present whenever a document is open.
~$*
