# =============================================================================
# MANNA SUPERVISOR - Flutter
#
# Copy to .env and edit. Read with --dart-define-from-file=.env, which Flutter
# applies at BUILD time - these are baked into the binary, exactly as the React
# client's VITE_ keys are baked into its bundle.
#
# So nothing in here is a secret. The API's own secrets - the Supabase keys,
# the JWT signing secrets - live in server/.env and never leave the server.
# This app holds no key of its own: it signs in with a name and a PIN and is
# given a token, like any other client.
#
# Consumed in lib/core/config/app_config.dart.
# =============================================================================

# The Express API this app talks to. Same routes the React client calls.
#
#   phone on a USB cable   http://localhost:5000/api/v1
#                          with `adb reverse tcp:5000 tcp:5000` - the tunnel
#                          carries the phone's localhost to the dev machine's,
#                          so no wifi and no firewall rule
#   Android emulator       http://10.0.2.2:5000/api/v1
#   dev machine on wifi    http://192.168.1.53:5000/api/v1
#                          needs inbound TCP 5000 open, and the host listed in
#                          android/app/src/main/res/xml/network_security_config.xml
#   deployed               https://your-api-host/api/v1
#
# Prefer HTTPS anywhere the device is not on the end of a cable: a session token
# on an unencrypted link is one anybody on the wifi can lift.
API_URL=http://localhost:5000/api/v1

# What the login screen and the task switcher call it.
APP_NAME=Manna Production Management
