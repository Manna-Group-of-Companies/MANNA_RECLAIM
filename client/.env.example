# =============================================================================
# MANNA RECLAIM - client. Copy to .env and adjust.
#
# Only VITE_-prefixed keys reach the browser, and every one of them is baked
# into the bundle at build time - so nothing here is a secret. Read in
# src/config/env.ts; add new keys to src/vite-env.d.ts too or TS won't see them.
# =============================================================================

# Base URL of the Express API. Leave as /api/v1 in dev so the Vite proxy on
# 5173 forwards to localhost:5000 and the browser stays on one origin - which
# is what lets the refresh cookie work without SameSite=None.
#
# In production keep it relative if the client and API are served from the same
# domain. Only use an absolute URL (https://api.example.com/api/v1) when they
# are genuinely split, and then the API needs COOKIE_SAMESITE=none as well.
VITE_API_URL=/api/v1

VITE_APP_NAME=Manna Production Management

# Redux devtools and the query inspector. Any value but "false" turns them on;
# set it to false for the build the plant actually runs.
VITE_ENABLE_DEVTOOLS=true

# Passcode on the back office's Costing tab (back.html used 2525). It ships
# inside the bundle, so it is a screen against onlookers, not access control -
# the manager/admin check on the route and the API is what actually guards it.
VITE_COSTING_PASSCODE=2525
