# =============================================================================
# MANNA RECLAIM - client (production build)
#
# Vite reads this file for `npm run build` only; `npm run dev` keeps using .env
# and its proxy. Anything not set here falls back to the default in
# src/config/env.ts. Nothing here is a secret - it is baked into the bundle.
# =============================================================================

# The Railway API. Absolute, with the scheme - a bare host is treated as a
# relative path by axios. The /api/v1 suffix must match API_PREFIX on the server.
#
# This puts the browser on a different origin to the API, which the refresh
# cookie only survives if the server is set to COOKIE_SAMESITE=none and
# COOKIE_SECURE=1, with this build's origin listed in CLIENT_URL.
VITE_API_URL=/api/v1

# Swap to this once the api CNAME resolves and Railway has issued the cert.
# Serving the client from reclaim.mannarubber.com then makes the two same-site,
# so the refresh cookie works on COOKIE_SAMESITE=lax and none is not needed.
# VITE_API_URL=https://api.mannarubber.com/api/v1

# Redux devtools and the query inspector, off for a shipped build.
VITE_ENABLE_DEVTOOLS=false
