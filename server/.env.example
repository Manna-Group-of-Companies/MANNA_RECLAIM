# =============================================================================
# MANNA RECLAIM - API. Copy to .env and fill in.
#
# Every key below is read in src/config/env.js and nowhere else. Commented-out
# keys fall back to the code default shown beside them; delete nothing, since
# assertEnv() refuses to start production with a missing or weak value.
# =============================================================================

# ---------- runtime ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=dev

# ---------- cors (comma separated) ----------
# Extra origins a browser will load the client from. These are ADDED to the
# always-allowed list in src/config/env.js (the dev server and the deployed
# client), so this only needs the ones not already there — a custom domain, a
# preview deployment. Comma separated, scheme included, no trailing slash.
CLIENT_URL=http://localhost:5173,http://localhost:4173

# ---------- auth ----------
# In production both must be set, at least 32 characters, and different from
# each other — the server refuses to start otherwise. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
# Stamped into every token and demanded back on verify. Only worth changing if
# this API shares a secret with something else, which it should not.
JWT_ISSUER=manna-reclaim-api
JWT_AUDIENCE=manna-reclaim-app
# Refreshing rotates the token: the one handed in is spent and a new pair goes
# back, so a cookie copied off a tablet stops working once that tablet refreshes.
# This is how long the spent token is still tolerated, so that two open tabs or a
# retried request don't sign the crew out. Seconds, not hours — keep it small.
REFRESH_GRACE_MS=60000

# ---------- refresh cookie ----------
# Leave as lax when the client is served from the same origin as the API (the
# Vite proxy in dev, or one domain in production). Hosted on two different
# domains the browser will not send a lax cookie to POST /auth/refresh at all
# and sessions die at the first token expiry — that setup needs:
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=1        (browsers only accept SameSite=None over HTTPS)
COOKIE_SAMESITE=lax
# Defaults to on in production. Requires HTTPS.
# COOKIE_SECURE=1
# Only needed to share the cookie across subdomains, e.g. .mannarubber.com
# COOKIE_DOMAIN=

# ---------- rate limit ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# login / PIN endpoints — failed attempts only (default 200 in dev, 20 in production)
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=200
# Writes only (POST/PATCH/PUT/DELETE). Reads are exempt, so this bounds what a
# stolen token can rewrite. Default 600 in production, 5000 in dev.
WRITE_RATE_LIMIT_WINDOW_MS=900000
WRITE_RATE_LIMIT_MAX=600

# ---------- behind a proxy / load balancer ----------
# Set when the API sits behind nginx, Caddy, Render, Fly, etc. Without it the
# rate limiters see the proxy's address for every request and count the whole
# plant as one client. Do NOT set it when the API is exposed directly — the
# client would then be able to spoof its own address via X-Forwarded-For.
# TRUST_PROXY=1

# ---------- supabase (the database) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Required once supabase/schema.sql has been run. That script turns on RLS and
# gives `users` a service-role-only policy, so with the anon key alone: login
# cannot read PIN hashes and falls back to the dev accounts in config/devSeed.js,
# and `npm run seed` cannot write users, machines or products.
# Supabase > Project Settings > API > service_role. It bypasses every policy -
# server-side only, and never committed.
# SUPABASE_SERVICE_KEY=
SUPABASE_PAGE_SIZE=1000
# Set to 0 to skip the boot-time table/column check.
SUPABASE_VERIFY_SCHEMA=1
