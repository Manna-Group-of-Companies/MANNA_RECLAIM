# ---------- runtime ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=dev

# ---------- cors (comma separated) ----------
CLIENT_URL=http://localhost:5173,http://localhost:4173

# ---------- auth ----------
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# ---------- rate limit ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# login / PIN endpoints — failed attempts only (default 200 in dev, 20 in production)
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=200

# ---------- supabase (the database) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Required to read `users` (PIN hashes are closed to the anon key), and to
# write anything once RLS is enabled. Never commit it.
# SUPABASE_SERVICE_KEY=
SUPABASE_PAGE_SIZE=1000
# Set to 0 to skip the boot-time table/column check.
SUPABASE_VERIFY_SCHEMA=1
