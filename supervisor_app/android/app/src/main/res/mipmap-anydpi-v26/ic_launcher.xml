<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8 and up take this in preference to the PNGs in mipmap-*dpi, and mask
  the two layers into the shape the launcher has been set to. The PNGs stay for
  everything older, where they are the whole icon.

  `monochrome` is the themed-icon layer Android 13 uses when the user turns on
  icon theming: the launcher recolours it to the wallpaper's palette, so it must
  be the silhouette alone, never the green tile.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
