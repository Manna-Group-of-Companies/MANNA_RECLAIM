{
  "name": "@manna/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src scripts test --ext .js --max-warnings 0",
    "test": "node --test \"test/**/*.test.js\"",
    "db:report": "node scripts/supabase-report.js",
    "seed:users": "node scripts/seed-users.js",
    "seed:machines": "node scripts/seed-machines.js",
    "seed:products": "node scripts/seed-products.js",
    "seed": "npm run seed:users && npm run seed:machines && npm run seed:products"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20"
  }
}
