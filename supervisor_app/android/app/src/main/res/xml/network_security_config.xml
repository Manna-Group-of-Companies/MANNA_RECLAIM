<?xml version="1.0" encoding="utf-8"?>
<!--
  Where this app is allowed to talk in the clear.

  Android blocks plain HTTP by default from API 28 up, and it is right to: a
  session token on an unencrypted link is a session token anybody on the wifi
  can lift. So the default below stays off, and the exceptions are named one at
  a time.

  What is named here is the development addresses and nothing else:

    localhost / 127.0.0.1   the `adb reverse tcp:5000 tcp:5000` tunnel, which
                            carries the phone's localhost to the dev machine's
                            over the USB cable. No wifi, no firewall rule.
    10.0.2.2                the Android emulator's route to its host.
    192.168.1.53            the dev machine on the plant wifi.

  A plant serving its API over plain HTTP on the LAN needs its own <domain>
  line added here. A plant serving it over HTTPS needs nothing: the default
  already allows that, and that is the arrangement to prefer.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.53</domain>
    </domain-config>
</network-security-config>
