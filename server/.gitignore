# dependencies
node_modules/

# env - holds SUPABASE_SERVICE_KEY, never commit
# .env.example is committed on purpose
.env
.env.local
.env.development.local
.env.production.local
.env.test.local
# a copy of .env is still a copy of the secrets
.env.bak
.env.*.bak

# logs
logs/
*.log
npm-debug.log*
pids/
*.pid
*.seed

# tests
coverage/
.nyc_output/

# runtime artifacts
uploads/
tmp/
temp/
# what scripts/lot-key-split.js writes before it touches anything - real plant
# rows, and not ours to commit
backups/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db
