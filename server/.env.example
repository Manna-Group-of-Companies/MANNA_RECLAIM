# ---------- runtime ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=dev

# ---------- cors (comma separated) ----------
CLIENT_URL=http://localhost:5173,http://localhost:4173

# ---------- auth ----------
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# ---------- mongodb ----------
# local: mongodb://127.0.0.1:27017
# atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=manna_reclaim
MONGODB_POOL_SIZE=10
MONGODB_TIMEOUT_MS=10000

# ---------- rate limit ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---------- supabase (source for scripts/migrate-supabase-to-mongo.js) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=   # required once RLS is enabled; never commit
SUPABASE_PAGE_SIZE=1000
